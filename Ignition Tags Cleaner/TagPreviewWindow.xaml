<Window x:Class="TagCleaner.TagPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TagCleaner"
        mc:Ignorable="d"
        Title="Tag Hierarchy Preview" Height="1000" Width="900"
        WindowStartupLocation="CenterOwner"
        Background="#FBFCFD"
        FontFamily="Segoe UI, Tahoma, sans-serif">

    <Window.Resources>
        <!-- Card Style -->
        <Style x:Key="ClassicCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderBrush" Value="#DDE2E8"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- Search TextBox Style -->
        <Style x:Key="SearchBoxStyle" TargetType="TextBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D1D5DA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="4"/>
                </Style>
            </Style.Resources>
        </Style>

        <!-- Standard Button Style -->
        <Style x:Key="StandardButton" TargetType="Button">
            <Setter Property="Background" Value="#F6F8FA"/>
            <Setter Property="Foreground" Value="#24292E"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4" BorderBrush="#D1D5DA" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#EFF2F5"/>
                                <Setter Property="BorderBrush" Value="#C6CBD1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TreeView Item Style -->
        <Style TargetType="TreeViewItem">
            <Setter Property="Padding" Value="4"/>
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
            <Setter Property="Visibility" Value="{Binding Visibility}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <Border x:Name="Bd" BorderBrush="Transparent" BorderThickness="0" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="true">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="19"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton x:Name="Expander" ClickMode="Press" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}">
                                        <ToggleButton.Style>
                                            <Style TargetType="ToggleButton">
                                                <Setter Property="UIElement.Focusable" Value="false"/>
                                                <Setter Property="FrameworkElement.Width" Value="16"/>
                                                <Setter Property="FrameworkElement.Height" Value="16"/>
                                                <Setter Property="Control.Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ToggleButton">
                                                            <Border Width="16" Height="16" Background="Transparent">
                                                                <Path x:Name="ExpandPath" Fill="Transparent" Stroke="#6A737D" StrokeThickness="1" Data="M 4 4 L 8 8 L 4 12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="ToggleButton.IsChecked" Value="true">
                                                                    <Setter TargetName="ExpandPath" Property="Path.Data" Value="M 4 6 L 8 10 L 12 6"/>
                                                                    <Setter TargetName="ExpandPath" Property="Path.Fill" Value="#6A737D"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ToggleButton.Style>
                                    </ToggleButton>
                                    <ContentPresenter x:Name="PART_Header" Grid.Column="1" ContentSource="Header" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                </Grid>
                            </Border>
                            <ItemsPresenter x:Name="ItemsHost" Grid.Row="1" Margin="18,0,0,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="TreeViewItem.IsExpanded" Value="false">
                                <Setter TargetName="ItemsHost" Property="UIElement.Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="ItemsControl.HasItems" Value="false">
                                <Setter TargetName="Expander" Property="UIElement.Visibility" Value="Hidden"/>
                            </Trigger>
                            <Trigger Property="TreeViewItem.IsSelected" Value="true">
                                <Setter TargetName="Bd" Property="Panel.Background" Value="#F1F8FF"/>
                                <Setter Property="TextElement.Foreground" Value="#005CC5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Hierarchical Data Template -->
        <HierarchicalDataTemplate x:Key="TagNodeTemplate" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal" Margin="2,0">
                <TextBlock x:Name="TypeIcon" Text="🏷" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="13" Foreground="#24292E"/>
                <Border x:Name="DataTypeBadge" Background="#F1F8FF" CornerRadius="3" Padding="6,2" Margin="12,0,0,0" VerticalAlignment="Center" BorderBrush="#005CC5" BorderThickness="0.5">
                    <TextBlock Text="{Binding DataType}" FontSize="9" FontWeight="Bold" Foreground="#005CC5"/>
                </Border>
                <Border x:Name="AlarmBadge" Background="#FFEBE9" CornerRadius="3" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center" BorderBrush="#FFC1C0" BorderThickness="0.5">
                    <TextBlock Text="🔔 Alarm" FontSize="9" FontWeight="Bold" Foreground="#CF222E"/>
                </Border>
            </StackPanel>
            <HierarchicalDataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsFolder}" Value="True">
                    <Setter TargetName="TypeIcon" Property="Text" Value="📁"/>
                    <Setter TargetName="TypeIcon" Property="Foreground" Value="#0066CC"/>
                    <Setter TargetName="DataTypeBadge" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="AlarmBadge" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding DataType}" Value="">
                    <Setter TargetName="DataTypeBadge" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding HasAlarms}" Value="False">
                    <Setter TargetName="AlarmBadge" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </HierarchicalDataTemplate.Triggers>
        </HierarchicalDataTemplate>
    </Window.Resources>

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Toolbar -->
            <RowDefinition Height="*"/>    <!-- Content -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,28">
            <TextBlock x:Name="WindowTitle" Text="Tag Hierarchy Preview" FontSize="24" FontWeight="SemiBold" Foreground="#1B1F23"/>
            <TextBlock x:Name="WindowSubtitle" Text="Visualizing tag structure after applying rules" FontSize="13" Foreground="#586069" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Toolbar & Search -->
        <Grid Grid.Row="1" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,0">
                <TextBlock Text="Folder Filter:" FontSize="12" FontWeight="SemiBold" Foreground="#6A737D" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox x:Name="FolderSearchBox" Style="{StaticResource SearchBoxStyle}" Width="220" Tag="Filter folders..." TextChanged="FilterBox_TextChanged"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Tag Filter:" FontSize="12" FontWeight="SemiBold" Foreground="#6A737D" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox x:Name="TagSearchBox" Style="{StaticResource SearchBoxStyle}" Width="220" Tag="Filter tags..." TextChanged="FilterBox_TextChanged"/>
            </StackPanel>
            
            <StackPanel Grid.Column="3" Orientation="Horizontal">
                <Button Content="Expand All" Style="{StaticResource StandardButton}" Click="ExpandAll_Click" Margin="0,0,8,0"/>
                <Button Content="Collapse All" Style="{StaticResource StandardButton}" Click="CollapseAll_Click"/>
            </StackPanel>
        </Grid>

        <!-- Content Area -->
        <Border Grid.Row="2" Style="{StaticResource ClassicCard}" Padding="20">
            <TreeView x:Name="TagTree" Background="Transparent" BorderThickness="0" 
                      ItemTemplate="{StaticResource TagNodeTemplate}" 
                      VirtualizingStackPanel.IsVirtualizing="True" 
                      VirtualizingStackPanel.VirtualizationMode="Standard"/>
        </Border>
    </Grid>
</Window>