<Window x:Class="TagCleaner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Ignition Tag Cleaner" Height="740" Width="940" MinHeight="700" MinWidth="880"
        WindowStartupLocation="CenterScreen" Background="#FBFCFD"
        FontFamily="Segoe UI, Tahoma, sans-serif">

    <Window.Resources>
        <!-- Card -->
        <Style x:Key="ClassicCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderBrush" Value="#DDE2E8"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- Primary Button -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#0066CC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="24,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinWidth" Value="150"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4" BorderBrush="#0052A3" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#0077EE"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#0055BB"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#E1E4E8"/>
                                <Setter Property="Foreground" Value="#959DA5"/>
                                <Setter Property="BorderBrush" Value="#D1D5DA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ghost/Secondary Button -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#F6F8FA"/>
            <Setter Property="Foreground" Value="#24292E"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4" BorderBrush="#D1D5DA" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#EFF2F5"/>
                                <Setter Property="BorderBrush" Value="#C6CBD1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Main Layout Container -->
        <Grid Margin="32,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="*"/>    <!-- Content -->
                <RowDefinition Height="Auto"/> <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- Header Section -->
            <Grid Grid.Row="0" Margin="0,0,0,32">
                <StackPanel>
                    <TextBlock Text="Ignition Tag Cleaner" FontSize="26" FontWeight="SemiBold" Foreground="#1B1F23"/>
                    <TextBlock Text="Filter PLC tag exports for Ignition" FontSize="13" Foreground="#586069" Margin="0,4,0,0"/>
                </StackPanel>
                
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button x:Name="EditRulesButton" Style="{StaticResource SecondaryButton}" Click="EditConfig_Click" Margin="0,0,8,0" ToolTip="Open config.xlsx in Microsoft Excel to edit rules" Width="140">
                        <TextBlock Text="Configure Rules" VerticalAlignment="Center" FontWeight="Medium"/>
                    </Button>
                    <Button x:Name="AboutButton" Style="{StaticResource SecondaryButton}" Click="About_Click" ToolTip="Information about Ignition Tag Cleaner" Width="140">
                        <TextBlock Text="About" VerticalAlignment="Center" FontWeight="Medium"/>
                    </Button>
                </StackPanel>
            </Grid>
            
            <!-- Content Section -->
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Drop Area -->
                <Grid x:Name="DropZoneContainer" Grid.Row="0" Height="135" AllowDrop="True" Drop="File_Drop" DragOver="File_DragOver" Margin="0,0,0,16">
                    <Rectangle Stroke="#D1D5DA" StrokeThickness="1.5" StrokeDashArray="4 2" RadiusX="8" RadiusY="8" Fill="#FBFCFD"/>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="Drop JSON Export File(s) Here" FontSize="15" FontWeight="SemiBold" Foreground="#24292E" HorizontalAlignment="Center"/>
                        <TextBlock Text="or click to browse" FontSize="12" Foreground="#6A737D" HorizontalAlignment="Center" Margin="0,4,0,10"/>
                        <Button Style="{StaticResource SecondaryButton}" Content="Select File(s)" Click="SelectFile_Click" MinWidth="120"/>
                    </StackPanel>
                </Grid>

                <!-- Processing / Fill Bar Indicator -->
                <Border x:Name="ProcessingIndicator" Grid.Row="1" Visibility="Collapsed" Background="#F1F8FF" BorderBrush="#BBD8FF" BorderThickness="1" CornerRadius="6" Padding="16,10" Margin="0,0,0,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock x:Name="ProcessingStatusText" Text="Analyzing tags..." FontSize="12" FontWeight="SemiBold" Foreground="#0066CC" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ProcessingDetailText" Text="Please wait..." FontSize="11" Foreground="#586069" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <ProgressBar x:Name="ProcessingProgressBar" Grid.Row="1" Height="6" IsIndeterminate="True" Foreground="#0066CC" Background="#DDE2E8" BorderThickness="0"/>
                    </Grid>
                </Border>

                <!-- Information Section -->
                <Border x:Name="FileInfoCard" Grid.Row="2" Style="{StaticResource ClassicCard}" Padding="28,24" VerticalAlignment="Top">
                    <StackPanel>
                        <Grid Margin="0,0,0,32">
                            <TextBlock Text="FILE ANALYSIS" FontSize="12" FontWeight="Bold" Foreground="#0066CC" VerticalAlignment="Center" Opacity="0.8"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="PreviewAllButton" Content="Preview All Tags" Style="{StaticResource SecondaryButton}" Padding="12,6" FontSize="11" Click="PreviewAll_Click" Margin="0,0,6,0" Width="140" IsEnabled="False"/>
                                <Button x:Name="PreviewOptimizedButton" Content="Preview Optimized Tags" Style="{StaticResource SecondaryButton}" Padding="12,6" FontSize="11" Click="PreviewOptimized_Click" Width="140" IsEnabled="False"/>
                            </StackPanel>
                        </Grid>
                        
                        <UniformGrid Columns="3">
                            <!-- Row 1: Source Info & Total Rules -->
                            <StackPanel Margin="0,0,16,16">
                                <TextBlock Text="PLC NAME" FontSize="10" FontWeight="Bold" Foreground="#6A737D" Margin="0,0,0,6"/>
                                <TextBlock x:Name="SelectedPLCNameDisplay" Text="-" FontSize="14" Foreground="#24292E" TextTrimming="CharacterEllipsis" FontWeight="Medium"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,16,16">
                                <TextBlock Text="SOURCE FILE(S)" FontSize="10" FontWeight="Bold" Foreground="#6A737D" Margin="0,0,0,6"/>
                                <TextBlock x:Name="FileNameText" Text="-" FontSize="14" Foreground="#24292E" TextTrimming="CharacterEllipsis" FontWeight="Medium"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,0,16">
                                <TextBlock Text="ACTIVE RULES LOADED" FontSize="10" FontWeight="Bold" Foreground="#6A737D" Margin="0,0,0,6"/>
                                <TextBlock x:Name="TotalRulesText" Text="0 Active" FontSize="14" Foreground="#0066CC" FontWeight="SemiBold"/>
                            </StackPanel>
                            
                            <!-- Row 2: File Specs & Full Folders -->
                            <StackPanel Margin="0,0,16,16">
                                <TextBlock Text="FILE SIZE" FontSize="10" FontWeight="Bold" Foreground="#6A737D" Margin="0,0,0,6"/>
                                <TextBlock x:Name="FileSizeText" Text="0.0 MB" FontSize="14" Foreground="#24292E" FontWeight="Medium"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,16,16">
                                <TextBlock Text="ORIGINAL TAGS" FontSize="10" FontWeight="Bold" Foreground="#6A737D" Margin="0,0,0,6"/>
                                <TextBlock x:Name="TotalTagsText" Text="0" FontSize="14" Foreground="#24292E" FontWeight="Medium"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,0,16">
                                <TextBlock Text="FOLDERS TO KEEP FULL" FontSize="10" FontWeight="Bold" Foreground="#6A737D" Margin="0,0,0,6"/>
                                <TextBlock x:Name="FullFoldersRuleCountText" Text="0" FontSize="14" Foreground="#24292E" FontWeight="Medium"/>
                            </StackPanel>

                            <!-- Row 3: Tag Filtering & Filtered Folders -->
                            <StackPanel Margin="0,0,16,16">
                                <TextBlock x:Name="TagsToRemoveLabel" Text="TAGS REMOVED" FontSize="10" FontWeight="Bold" Foreground="#6A737D" Margin="0,0,0,6"/>
                                <TextBlock x:Name="TagsToRemoveText" Text="0" FontSize="14" Foreground="#D73A49" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,16,16">
                                <TextBlock Text="TAGS REMAINING" FontSize="10" FontWeight="Bold" Foreground="#6A737D" Margin="0,0,0,6"/>
                                <TextBlock x:Name="TagsRemainingText" Text="0" FontSize="14" Foreground="#28A745" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,0,16">
                                <TextBlock Text="FOLDERS TO FILTER" FontSize="10" FontWeight="Bold" Foreground="#6A737D" Margin="0,0,0,6"/>
                                <TextBlock x:Name="FilteredFoldersRuleCountText" Text="0" FontSize="14" Foreground="#24292E" FontWeight="Medium"/>
                            </StackPanel>

                            <!-- Row 4: Folders Removed, Reduction Efficiency, & Specific Tags to Keep -->
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="FOLDERS REMOVED" FontSize="10" FontWeight="Bold" Foreground="#6A737D" Margin="0,0,0,6"/>
                                <TextBlock x:Name="FoldersRemovedText" Text="0" FontSize="14" Foreground="#D73A49" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="REDUCTION RATIO" FontSize="10" FontWeight="Bold" Foreground="#6A737D" Margin="0,0,0,6"/>
                                <TextBlock x:Name="ReductionRatioText" Text="0.0%" FontSize="14" Foreground="#6F42C1" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,0,0">
                                <TextBlock Text="SPECIFIC TAGS TO KEEP" FontSize="10" FontWeight="Bold" Foreground="#6A737D" Margin="0,0,0,6"/>
                                <TextBlock x:Name="TagsToKeepRuleCountText" Text="0" FontSize="14" Foreground="#24292E" FontWeight="Medium"/>
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Footer Section -->
            <Grid Grid.Row="2" Margin="0,28,0,0">
                <Button x:Name="ProcessButton" Content="Generate Export" IsEnabled="False" HorizontalAlignment="Right" Click="Process_Click" Style="{StaticResource PrimaryButton}"/>
            </Grid>
        </Grid>

        <!-- Overlay for Success -->
        <Border x:Name="SuccessOverlay" Background="#F0FFFFFF" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="600">
                <TextBlock Text="✓" FontSize="56" Foreground="#28A745" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                <TextBlock Text="Export Generated Successfully" FontSize="26" FontWeight="SemiBold" Foreground="#1B1F23" HorizontalAlignment="Center"/>
                <TextBlock x:Name="SuccessDetailsText" Text="Process finished." FontSize="14" Foreground="#586069" Margin="0,16,0,40" HorizontalAlignment="Center" TextAlignment="Center"/>
                
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Style="{StaticResource SecondaryButton}" Content="Open Folder" Click="OpenExportFolder_Click" Margin="0,0,12,0" Padding="28,12" FontWeight="Medium"/>
                    <Button Style="{StaticResource PrimaryButton}" Content="Done" Click="CloseSuccessOverlay_Click" Padding="32,12"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>