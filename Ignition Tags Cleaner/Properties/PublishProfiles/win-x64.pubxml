<?xml version="1.0" encoding="utf-8"?>
<!--
  Release build for distribution: one self-contained .exe that includes the .NET runtime,
  so users do not need .NET installed. config.xlsx is published next to it.

  dotnet publish "Ignition Tags Cleaner/Ignition Tags Cleaner.csproj" -p:PublishProfile=win-x64
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- WPF's native libraries go inside the .exe too, instead of beside it. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>none</DebugType>
  </PropertyGroup>
</Project>
